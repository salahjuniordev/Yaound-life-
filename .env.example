# Supabase configuration (optional for offline play).
# Copy this file to .env and fill in your project values.
# The anon key is a public client key protected by Row Level Security.
# NEVER put the service_role key in this file or in any client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional telemetry. Leave blank to disable; SDKs are lazy-loaded after first paint.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_POSTHOG_KEY=phc_example
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
